+#[cfg(test)]
+mod late_description_controls {
+    use super::*;
+    #[test]
+    fn only_discarded_descriptions_may_change() {
+        let original = ImageInfo::new(1, 1, ImageFormat::Png);
+        for change in [
+            (|i: &mut ImageInfo| i.width = 2) as fn(&mut ImageInfo),
+            |i| i.height = 2,
+            |i| i.format = ImageFormat::Jpeg,
+            |i| i.source_color.icc_profile = Some(std::sync::Arc::from(&b"late ICC"[..])),
+            |i| i.orientation = zencodec::Orientation::Rotate90,
+            |i| {
+                i.resolution = Some(zencodec::Resolution {
+                    x: 72.0,
+                    y: 72.0,
+                    unit: zencodec::ResolutionUnit::Inch,
+                })
+            },
+        ] {
+            let mut changed = original.clone();
+            change(&mut changed);
+            for treatment in [
+                MetadataTransfer::DiscardDescriptive,
+                MetadataTransfer::PreserveReported,
+            ] {
+                assert!(
+                    Epoch::capture(&original, treatment)
+                        .check_fields(&changed)
+                        .is_err()
+                );
+            }
+        }
+        for change in [
+            (|i: &mut ImageInfo| {
+                i.embedded_metadata.exif = Some(std::sync::Arc::from(&b"late EXIF"[..]))
+            }) as fn(&mut ImageInfo),
+            |i| i.embedded_metadata.xmp = Some(std::sync::Arc::from(&b"late opaque XML"[..])),
+        ] {
+            let mut changed = original.clone();
+            change(&mut changed);
+            assert!(
+                Epoch::capture(&original, MetadataTransfer::DiscardDescriptive)
+                    .check_fields(&changed)
+                    .is_ok()
+            );
+            assert!(
+                Epoch::capture(&original, MetadataTransfer::PreserveReported)
+                    .check_fields(&changed)
+                    .is_err()
+            );
+        }
+    }
+}
